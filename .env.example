# LiteLLM model identifier, including its provider prefix when required.
MODEL_ID=openai/your-model-name

# Add provider credentials to your local .env only. Never commit real secrets.
# OPENAI_API_KEY=replace-me

# LangSmith OpenTelemetry export. Leave unset to keep telemetry local/no-op.
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=refund-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# OTEL_SERVICE_NAME=refund-agent
# REFUND_AGENT_OTEL_EXPORT=true
# REFUND_AGENT_TRACE_CONTENT=false
# LangSmith accepts OTLP traces, not metrics. Use a compatible metrics endpoint.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
